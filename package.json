{
  "name": "prism-translate",
  "description": "Prism — AI Page Translator (WXT + TypeScript + Solid)",
  "private": true,
  "version": "13.0.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "htmlparser2": "^12.0.0",
    "solid-js": "^1.9.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "^2.31.1",
    "@wxt-dev/i18n": "^0.2.6",
    "@wxt-dev/module-solid": "^1.1.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wxt": "^0.21.2"
  }
}
